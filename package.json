  "devDependencies": {
    "@ai-sdk/openai-compatible": "1.0.26",
    "@types/bun": "latest",
    "@types/hast": "^3.0.4",
    "@types/react": "19.2.0",
    "ai": "5.0.87",
    "ansi-escapes": "^7.0.0",
    "chalk": "^5.4.1",
    "cli-highlight": "^2.1.11",
    "color": "4.2.3",
    "command-exists": "^1.2.9",
    "dayjs": "^1.11.20",
    "diff": "^8.0.2",
    "glob": "^13.0.0",
    "hast": "^1.0.0",
    "immer": "^10.1.1",
    "ink": "7.0.3",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-link": "^4.0.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "lowlight": "^3.3.0",
    "openai": "^6.37.0",
    "pathe": "^2.0.3",
    "react": "19.2.0",
    "string-width": "^7.2.0",
    "tar": "^7.5.2",
    "tsx": "^4.21.0",
    "type-fest": "^4.41.0",
    "typescript": "^5.8.3",
    "yargs": "^17.7.2",
    "zod": "3.25.76",
    "zustand": "^5.0.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "bin": {
    "dscode": "bundle/dscode.js"
  },
  "files": [
    "bundle/"
  ],
  "private": true,
  "scripts": {
    "build": "bun build index.tsx --external react-devtools-core --minify --outfile bundle/dscode.js --target=node && bun build:post",
    "build:post": "bun scripts/post-build.ts",
    "dev": "bun --watch ./index.tsx",
    "sfe": "bun build --compile --external react-devtools-core --target=bun-darwin-arm64 ./index.tsx --outfile one",
    "typecheck": "tsc -p ./ --noEmit"
  },
  "type": "module"
}
